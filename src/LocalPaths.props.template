<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-machine path overrides for AirlineTycoon.
  Copy this file to LocalPaths.props (gitignored) and edit for your machine.

  GameInstallDir — the folder containing the game assets and where AT.exe
                   will be copied after each build.

  Default (if LocalPaths.props is absent): C:\Games\Airline Tycoon Deluxe
  GOG install example:   C:\Games\Airline Tycoon Deluxe
  Steam install example: D:\Games\Steam\steamapps\common\Airline Tycoon Deluxe
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <GameInstallDir>C:\Games\Airline Tycoon Deluxe</GameInstallDir>
  </PropertyGroup>
</Project>
